# Copy to .env, next to docker-compose.yml, and fill in real values. .env is
# gitignored — never commit it. Compose injects these into the container's
# environment (env_file:), where certminder resolves any ${VAR} referenced in
# certminder.yml.

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/xxxx
WEBHOOK_TOKEN=abc123
SMTP_PASSWORD=SuperSecret
